<Window x:Class="PlasticBrainSim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PlasticBrainSim"
        Title="Plastic Brain Lab" Height="920" Width="1320"
        MinHeight="740" MinWidth="1050"
        Background="#11151B" Foreground="#E8EDF2">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#ECECEC" Foreground="Black">
            <MenuItem Header="Datei">
                <MenuItem Header="Aktuellen Agent speichern" IsEnabled="False"/>
                <MenuItem Header="Agent laden" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="Info">
                <MenuItem Header="Readme anzeigen" Click="ShowReadme_Click"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="160"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="StartPauseButton" Content="Start" Width="90" Height="34"
                            Margin="0,0,8,0" Click="StartPause_Click"/>
                    <Button Content="Einzelschritt" Width="105" Height="34"
                            Margin="0,0,8,0" Click="SingleStep_Click"/>
                    <Button Content="Neustart" Width="90" Height="34"
                            Margin="0,0,18,0" Click="Reset_Click"/>
                    <TextBlock Text="Tempo" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="SpeedSlider" Minimum="1" Maximum="40" Value="3"
                            Width="170" TickFrequency="1" IsSnapToTickEnabled="True"
                            ValueChanged="SpeedSlider_ValueChanged"/>
                    <TextBlock x:Name="SpeedText" Text="3x" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="Raeumliches Netz mit lokaler und struktureller Plastizitaet"
                           FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="0,0,8,0" BorderBrush="#303A46"
                        BorderThickness="1" CornerRadius="6" Background="#0B0F14" ClipToBounds="True">
                    <local:SimulationView x:Name="WorldView" DisplayMode="World"/>
                </Border>

                <TabControl Grid.Column="1" Margin="8,0,0,0" Background="#151B23" BorderBrush="#303A46">
                    <TabItem Header="Agentstatus" IsSelected="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#151B23" Foreground="White">
                            <Grid x:Name="AgentStatusPanel" Margin="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.ColumnSpan="2" Text="Identitaet und Koerper" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Text="Name"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Name, Mode=OneWay}"/>
                                <TextBlock Grid.Row="2" Text="Geschlecht"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Gender, Mode=OneWay}"/>
                                <TextBlock Grid.Row="3" Text="Lebenspunkte"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Body.LifePoint, Mode=OneWay, StringFormat=F1}"/>
                                <TextBlock Grid.Row="4" Text="Damage"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Damage, Mode=OneWay}"/>
                                <TextBlock Grid.Row="5" Text="Position"/><TextBlock x:Name="AgentPositionText" Grid.Row="5" Grid.Column="1"/>
                                <TextBlock Grid.Row="6" Text="Sichtwinkel"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding VisionAngleDegrees, Mode=OneWay, StringFormat={}{0:F1} Grad}"/>
                                <TextBlock Grid.Row="7" Text="Sichtreichweite"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding VisionRange, Mode=OneWay, StringFormat=F3}"/>

                                <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Text="Lernen und Verhalten" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,8"/>
                                <TextBlock Grid.Row="9" Text="Neuronen"/><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Brain.Neurons.Count, Mode=OneWay}"/>
                                <TextBlock Grid.Row="10" Text="Synapsen"/><TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding Brain.SynapseCount, Mode=OneWay}"/>
                                <TextBlock Grid.Row="11" Text="Neuigkeit"/><TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding LastNovelty, Mode=OneWay, StringFormat=F3}"/>
                                <TextBlock Grid.Row="12" Text="Belohnung"/><TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding LastReward, Mode=OneWay, StringFormat=F3}"/>
                                <TextBlock Grid.Row="13" Text="Regelaktion"/><TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding LastRuleAction, Mode=OneWay}"/>
                                <TextBlock Grid.Row="14" Text="Motivationen"/><TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding MotivationNames, Mode=OneWay}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="15" Text="Erinnerungen"/><TextBlock Grid.Row="15" Grid.Column="1" Text="{Binding Memory.WorldObjects.Count, Mode=OneWay}"/>
                                <TextBlock Grid.Row="16" Text="Regeln"/><TextBlock Grid.Row="16" Grid.Column="1" Text="{Binding Rules.Rules.Count, Mode=OneWay}"/>
                                <TextBlock Grid.Row="17" Text="Nahrung / Schaden"/><TextBlock x:Name="AgentExperienceText" Grid.Row="17" Grid.Column="1"/>
                                <TextBlock Grid.Row="18" Text="Netz allein"/>
                                <TextBlock Grid.Row="18" Grid.Column="1">
                                    <Run Text="{Binding NetworkDecisionPercent, Mode=OneWay, StringFormat={}{0:F1}%}"/>
                                    <Run Text="  ("/>
                                    <Run Text="{Binding NetworkOnlyDecisionCount, Mode=OneWay}"/>
                                    <Run Text=" Schritte)"/>
                                </TextBlock>
                                <TextBlock Grid.Row="19" Text="Regel beteiligt"/>
                                <TextBlock Grid.Row="19" Grid.Column="1">
                                    <Run Text="{Binding RuleDecisionPercent, Mode=OneWay, StringFormat={}{0:F1}%}"/>
                                    <Run Text="  ("/>
                                    <Run Text="{Binding RuleInfluencedDecisionCount, Mode=OneWay}"/>
                                    <Run Text=" Schritte)"/>
                                </TextBlock>

                                <TabControl Grid.Row="20" Grid.ColumnSpan="2" Margin="0,14,0,0"
                                            Background="#151B23" BorderBrush="#303A46">
                                    <TabItem Header="Regeln">
                                        <ItemsControl ItemsSource="{Binding Rules.Rules, Mode=OneWay}" Margin="8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,3" Padding="10" Background="#1B232D"
                                                            BorderBrush="#303A46" BorderThickness="1" CornerRadius="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="54"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="38" Height="38" CornerRadius="4"
                                                                    BorderBrush="#C0CAD4" BorderThickness="1">
                                                                <Border.Background>
                                                                    <MultiBinding Converter="{StaticResource ObjectColorBrushConverter}">
                                                                        <Binding Path="Color.Red" Mode="OneWay"/>
                                                                        <Binding Path="Color.Green" Mode="OneWay"/>
                                                                        <Binding Path="Color.Blue" Mode="OneWay"/>
                                                                    </MultiBinding>
                                                                </Border.Background>
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Description, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                <TextBlock Foreground="#B9C4CF" Margin="0,3,0,0">
                                                                    <Run Text="Farbe: "/><Run Text="{Binding ColorText, Mode=OneWay}"/>
                                                                    <Run Text="  ("/><Run Text="{Binding ColorToleranceText, Mode=OneWay}"/><Run Text=")"/>
                                                                </TextBlock>
                                                                <TextBlock Foreground="#B9C4CF">
                                                                    <Run Text="Groessenbereich: "/><Run Text="{Binding SizeRangeText, Mode=OneWay}"/>
                                                                </TextBlock>
                                                                <TextBlock Foreground="#B9C4CF">
                                                                    <Run Text="Staerke: "/><Run Text="{Binding Strength, Mode=OneWay, StringFormat=F2}"/>
                                                                    <Run Text="   Belege: "/><Run Text="{Binding EvidenceCount, Mode=OneWay}"/>
                                                                </TextBlock>
                                                                <TextBlock Foreground="#8996A5" FontSize="11">
                                                                    <Run Text="Erstellt bei Schritt "/><Run Text="{Binding CreatedAtStep, Mode=OneWay}"/>
                                                                    <Run Text="   zuletzt bestaetigt "/><Run Text="{Binding LastConfirmedStep, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </TabItem>
                                    <TabItem Header="Erinnerungen">
                                        <ItemsControl ItemsSource="{Binding Memory.WorldObjects, Mode=OneWay}" Margin="8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,3" Padding="10" Background="#1B232D"
                                                            BorderBrush="#303A46" BorderThickness="1" CornerRadius="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="54"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="38" Height="38" CornerRadius="4"
                                                                    BorderBrush="#C0CAD4" BorderThickness="1">
                                                                <Border.Background>
                                                                    <MultiBinding Converter="{StaticResource ObjectColorBrushConverter}">
                                                                        <Binding Path="Color.Red" Mode="OneWay"/>
                                                                        <Binding Path="Color.Green" Mode="OneWay"/>
                                                                        <Binding Path="Color.Blue" Mode="OneWay"/>
                                                                    </MultiBinding>
                                                                </Border.Background>
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Description, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding TargetText, Mode=OneWay}" Foreground="#FFD750" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding LearnedMeaningText, Mode=OneWay}" Foreground="#B9C4CF"/>
                                                                <TextBlock Foreground="#B9C4CF" Margin="0,3,0,0">
                                                                    <Run Text="Farbe: "/><Run Text="{Binding ColorText, Mode=OneWay}"/>
                                                                    <Run Text="   Groesse: "/><Run Text="{Binding Size, Mode=OneWay, StringFormat=F3}"/>
                                                                </TextBlock>
                                                                <TextBlock Foreground="#B9C4CF">
                                                                    <Run Text="Position: "/><Run Text="{Binding PositionText, Mode=OneWay}"/>
                                                                </TextBlock>
                                                                <TextBlock Foreground="#B9C4CF">
                                                                    <Run Text="Nahrung: "/><Run Text="{Binding Food, Mode=OneWay}"/>
                                                                    <Run Text="   Schaden: "/><Run Text="{Binding Damage, Mode=OneWay}"/>
                                                                    <Run Text="   Lebenspunkte: "/><Run Text="{Binding LifePoint, Mode=OneWay}"/>
                                                                </TextBlock>
                                                                <TextBlock Foreground="#8996A5" FontSize="11">
                                                                    <Run Text="Zuletzt gesehen bei Schritt "/><Run Text="{Binding LastSeenStep, Mode=OneWay}"/>
                                                                    <Run Text="   verbleibend: "/><Run Text="{Binding RemainingLifetime, Mode=OneWay}"/>
                                                                    <Run Text=" Schritte"/>
                                                                </TextBlock>
                                                                <TextBlock Foreground="#B9C4CF">
                                                                    <Run Text="Bewerteter Nutzen: "/><Run Text="{Binding EvaluatedUtility, Mode=OneWay, StringFormat=F2}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Netz">
                        <Border Background="#0B0F14" ClipToBounds="True">
                            <local:SimulationView x:Name="NetworkView" DisplayMode="Brain"/>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>

            <DataGrid x:Name="AgentGrid" Grid.Row="2" Margin="0,12,0,0"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      SelectionChanged="AgentGrid_SelectionChanged"
                      Background="#151B23" Foreground="#E8EDF2" BorderBrush="#303A46"
                      RowBackground="#151B23" AlternatingRowBackground="#1B232D"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Foreground" Value="Black"/></Style></DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="90"/>
                    <DataGridTextColumn Header="Geschlecht" Binding="{Binding Gender, Mode=OneWay}" Width="85"/>
                    <DataGridTextColumn Header="Leben" Binding="{Binding Body.LifePoint, Mode=OneWay, StringFormat=F1}" Width="60"/>
                    <DataGridTextColumn Header="Damage" Binding="{Binding Damage, Mode=OneWay}" Width="65"/>
                    <DataGridTextColumn Header="Neuronen" Binding="{Binding Brain.Neurons.Count, Mode=OneWay}" Width="75"/>
                    <DataGridTextColumn Header="Synapsen" Binding="{Binding Brain.SynapseCount, Mode=OneWay}" Width="75"/>
                    <DataGridTextColumn Header="Nahrung" Binding="{Binding FoodCollected, Mode=OneWay}" Width="70"/>
                    <DataGridTextColumn Header="Schaden" Binding="{Binding HazardHits, Mode=OneWay}" Width="70"/>
                    <DataGridTextColumn Header="Neuigkeit" Binding="{Binding LastNovelty, Mode=OneWay, StringFormat=F2}" Width="70"/>
                    <DataGridTextColumn Header="Erinnerungen" Binding="{Binding Memory.WorldObjects.Count, Mode=OneWay}" Width="90"/>
                    <DataGridTextColumn Header="Regeln" Binding="{Binding Rules.Rules.Count, Mode=OneWay}" Width="55"/>
                    <DataGridTextColumn Header="Regelaktion" Binding="{Binding LastRuleAction, Mode=OneWay}" Width="80"/>
                    <DataGridTextColumn Header="Motivation" Binding="{Binding MotivationNames, Mode=OneWay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" FontFamily="Consolas" FontSize="13"/>
                <TextBlock Grid.Column="1" Foreground="#8996A5" Text="Gestrichelt: Erinnerung   Linien im Netz: aktive Synapsen"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
